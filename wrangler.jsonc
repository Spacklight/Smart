{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "smart",
  "main": "worker.js",
  "compatibility_date": "2026-09-27",
  "compatibility_flags": ["nodejs_compat"],
  "alias": {
    "iconv-lite": "./shims/iconv-lite.cjs"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/apiv1", "/apiv1/*"]
  },
  "vars": {
    "HF_DATASET": "Spacklight/chiwoko",
    "EMAIL_PLATFORM_URL": "https://email.emalawi19.workers.dev",
    "NODE_ENV": "production",
    "CLOUDFLARE": "1",
    "PUBLIC_URL": "https://smartbase.de5.net"
  },
  "observability": {
    "enabled": true
  }
}
